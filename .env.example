# Archivo de configuración de entorno
# Copia este archivo a .env y configura tus valores

# OpenAI API Key (REQUERIDO)
OPENAI_API_KEY=tu_api_key_aqui

# ChromaDB Configuration
CHROMA_PERSIST=1  # 1 para persistencia, 0 para modo memoria (recomendado en Win+Python3.13)
CHROMA_PERSIST_PATH=./rag_storage  # Ruta personalizada para ChromaDB

# Orchestrator Strategy (NUEVO - Optimización de contexto)
USE_SMART_ORCHESTRATOR=true  # true para arquitectura optimizada de 3 fases, false para agente tradicional

# Notas:
# - Smart Orchestrator: Ahorra 90%+ tokens, mejor para tareas estructuradas
# - Agent tradicional: Más flexible, mejor para conversaciones exploratorias
